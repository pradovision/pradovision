NODE_ENV=production
# Railway Postgres: use ${{Postgres.DATABASE_URL}} reference in Railway dashboard
DATABASE_URL=
# Set these two for FIRST BOOT ONLY. Remove the bootstrap password after account creation.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional verified public hostname (no protocol); when set, requests with other hosts can still use Railway preview domains.
PUBLIC_SITE_URL=https://pradovision.com.br
